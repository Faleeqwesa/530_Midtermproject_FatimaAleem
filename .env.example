# Optional: enables the LLM-generated explanation in the agent tab.
# Keep this value in Streamlit Secrets or your local .env file. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional path to the CDC CSV when running locally.
CDC_DATA_PATH=U.S._Chronic_Disease_Indicators_20260930.csv
